# Local infrastructure
DB_DRIVER=net.sf.log4jdbc.sql.jdbcapi.DriverSpy
DB_URL=jdbc:log4jdbc:mysql://localhost:3307/secondzip
DB_USERNAME=secondzip
DB_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# Public data APIs
REALTY_PRICE_API_KEY=change-me
BUILDING_HUB_API_KEY=change-me
KAKAO_REST_API_KEY=change-me
OPEN_API_KEY=change-me

# CODEF demo environment
CODEF_CLIENT_ID=change-me
CODEF_CLIENT_SECRET=change-me
CODEF_PUBLIC_KEY=change-me
CODEF_LOGIN_PHONE_NO=change-me
CODEF_LOGIN_PASSWORD=change-me
CODEF_EPREPAY_NO=change-me
CODEF_EPREPAY_PASS=change-me
CODEF_REGISTRY_ENABLED=true
CODEF_REGISTRY_BASE_URL=https://development.codef.io
CODEF_BUILDING_REGISTER_ENABLED=true
CODEF_BUILDING_REGISTER_BASE_URL=https://development.codef.io

# Analysis workflow
ANALYSIS_WORKFLOW_TTL_SECONDS=900
EXTERNAL_API_MODE=real

# Other integrations
