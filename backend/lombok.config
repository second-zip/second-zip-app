# 상위 디렉터리의 lombok.config 탐색을 여기서 멈춘다.
config.stopBubbling = true

# Lombok 이 생성한 getter/setter/equals/hashCode/toString/builder 에
# @lombok.Generated 어노테이션을 붙인다.
# JaCoCo 는 @Generated 가 붙은 메서드를 커버리지 계산에서 자동으로 제외하므로,
# "사람이 쓰지 않은 코드"가 미커버로 잡히는 것을 막는다.
# 이 프로젝트는 DTO 가 60개 이상이라 이 한 줄이 커버리지 수치를 크게 바꾼다.
lombok.addLombokGeneratedAnnotation = true
