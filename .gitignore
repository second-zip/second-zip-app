# ==================================================
# Environment variables / secrets
# ==================================================
.env
.env.*
**/.env
**/.env.*

# Keep example environment files
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# Spring local/secret configuration
**/src/main/resources/application-local.yml
**/src/main/resources/application-local.yaml
**/src/main/resources/application-local.properties
**/src/main/resources/application-secret.yml
**/src/main/resources/application-secret.yaml
**/src/main/resources/application-secret.properties


# ==================================================
# Frontend - Vue / Vite / Node.js
# ==================================================
**/node_modules/
**/dist/
**/.vite/
**/.cache/
**/coverage/
**/views/test/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

*.local


# ==================================================
# Frontend additional build / tooling files
# ==================================================
**/dist-ssr/
*.tsbuildinfo
**/.eslintcache

# Cypress
**/cypress/videos/
**/cypress/screenshots/

# Vitest
**/__screenshots__/

# Vite
*.timestamp-*-*.mjs


# ==================================================
# Backend - Spring / Java / Gradle / Maven
# ==================================================
**/.gradle/
**/build/
**/target/
**/out/
**/bin/

# IntelliJ compiler output
*.class

# Do not ignore Gradle Wrapper
!**/gradle/wrapper/gradle-wrapper.jar


# ==================================================
# IDE / Editor
# ==================================================
.idea/
*.iml
*.ipr
*.iws

.classpath
.project
.settings/


# ==================================================
# VS Code
# ==================================================
**/.vscode/*
!**/.vscode/extensions.json


# ==================================================
# OS files
# ==================================================
.DS_Store
.AppleDouble
.LSOverride

Thumbs.db
Desktop.ini


# ==================================================
# Logs / temporary files
# ==================================================
*.log
logs/
**/logs/

*.tmp
*.temp
*.swp
*.swo
*~


# ==================================================
# Test / tooling
# ==================================================
**/.nyc_output/
**/test-results/
**/playwright-report/


# ==================================================
# Local runtime files
# ==================================================
*.pid
*.seed
*.pid.lock

# ==================================================
# Private document
# ==================================================
*.md
!README.md
!docs/**/*.md

# 문서 폴더
/docs/
/_stage/